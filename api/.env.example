# Konfiguration der Web-API. Kopieren nach api/.env und anpassen — oder diese
# Werte im Wrapper-Skript bzw. im launchd-Plist setzen (siehe autostart/).
#
# Diese Datei gab es vorher nicht; die beiden Werte lebten ausschließlich in
# einem Startskript außerhalb des Repositorys.

# ─── Datenbank ──────────────────────────────────────────────────────────────
# Einen absoluten Pfad verwenden. Der Default ist relativ zum Arbeitsverzeichnis,
# und ein aus einem Unterordner gestarteter Dienst legt dann eine zweite, leere
# Datenbank an statt die vorhandene zu benutzen.
#
# Alembic liest denselben Wert (migrations/env.py hat Vorrang vor alembic.ini),
# damit Migration und Anwendung garantiert dieselbe Datei treffen.
DATABASE_URL=sqlite+aiosqlite:////absoluter/pfad/zu/Akouo/data/akouo.db

# ─── Audio-Dienst ───────────────────────────────────────────────────────────
# Wo der native Audio-Dienst erreichbar ist. Die API ist der einzige, der mit ihm
# spricht; der Browser kennt nur Port 8000.
AUDIO_SERVICE_URL=http://127.0.0.1:8001

# ─── Hochgeladene Dateien ───────────────────────────────────────────────────
# Ziel für nachträglich hochgeladene MP3s.
#UPLOADS_DIR=~/Recordings/Akouo/uploads
