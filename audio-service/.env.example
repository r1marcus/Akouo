# Konfiguration des Audio-Dienstes. Kopieren nach audio-service/.env und anpassen.
#
#   cp audio-service/.env.example audio-service/.env
#
# Alle Werte haben einen Default im Code; diese Datei zeigt sie vollständig, damit
# man nicht erst audio-service/config.py lesen muss.

# ─── Audio-Eingang ──────────────────────────────────────────────────────────
# Das erste Gerät, dessen Name einen dieser Begriffe enthält, wird genommen.
# Reihenfolge entscheidet. Mit `python audio-service/scripts/pruefe_erkennung.py`
# lässt sich prüfen, was gefunden wird.
AUDIO_DEVICE_NAMES=Dante,Focusrite

# Gerätekanäle, 1-basiert. Das Aufnahme-Paar landet in der WAV, das Stream-Paar
# geht an den Livestream und den Mithör-Bus.
#
# Default ist zweimal dasselbe Paar: so läuft es mit jedem Stereo-Eingang.
# Wer Aufnahme und Stream getrennt mischt, setzt zwei verschiedene Paare —
# in der Beispielanlage sind das Dante 44/45 und 46/47.
AUDIO_RECORD_CHANNELS=1,2
AUDIO_STREAM_CHANNELS=1,2

# Muss zur Soundkarte passen. Dante läuft üblicherweise auf 48000.
AUDIO_SAMPLE_RATE=48000

# Wohin Aufnahmen, Sessions und Exporte geschrieben werden.
# Achtung: die Datenbank speichert absolute Pfade zu den Aufnahmen. Diesen Wert
# nach der Erstinstallation nicht mehr ändern, ohne die Pfade mitzumigrieren.
#RECORDINGS_DIR=~/Recordings/Akouo

# ─── Livestream ─────────────────────────────────────────────────────────────
# Icecast oder RTMP. Leer lassen heißt: kein Stream, das Dashboard zeigt
# "Nicht konfiguriert". Die Zugangsdaten stehen in der URL, deshalb gehört
# diese Datei nicht in die Versionsverwaltung.
#
#   Icecast: icecast://source:PASSWORT@stream.example.org:8000/mount
#   RTMP:    rtmp://a.rtmp.youtube.com/live2/STREAM-KEY
STREAM_URL=

# ─── Live-Transkription (whisper.cpp) ───────────────────────────────────────
# Braucht einen laufenden whisper-server. Ohne ihn bleibt das Transkript leer,
# die Aufnahme läuft unverändert weiter.
TRANSCRIBE_ENABLED=1
TRANSCRIBE_CHUNK_SECONDS=10
# Sprache der Aufnahme — für Nachnutzer außerhalb des deutschen Sprachraums
# der erste Schalter, den es zu ändern gilt.
TRANSCRIBE_LANGUAGE=de
WHISPER_URL=http://127.0.0.1:8090/inference

# ─── KI-Auswertung (Ollama) ─────────────────────────────────────────────────
# Ohne laufendes Ollama entfallen Zusammenfassungen und die Auswertung der
# Ansagen; es bricht nichts ab.
OLLAMA_URL=http://127.0.0.1:11434

# Das erste installierte Modell aus dieser Liste wird benutzt.
# Lizenzhinweis: qwen2.5 steht unter Apache-2.0, die Llama-Modelle unter Metas
# Community License, die keine OSI-Open-Source-Lizenz ist. Siehe NOTICE.
OLLAMA_MODELS=qwen2.5:14b-instruct,llama3.1:8b,llama3.2

# Eigenes Modell für die Auswertung der Ansagen im Transkript.
PROGRAMM_MODELL=qwen2.5:14b-instruct

# Ableiten des Beitragstyps aus den Ansagen. Auf 0 setzen, wenn die Automatik
# nur nach Klang entscheiden soll.
PROGRAMM_AUTOMATISCH=1

# ─── NAS-Upload über SMB ────────────────────────────────────────────────────
# Wichtig: Schon ein gesetztes NAS_SERVER genügt, damit der Export den Upload
# versucht. Ist das NAS dann nicht erreichbar oder die Freigabe gesperrt, steht
# bei jeder Datei "fehlgeschlagen" statt sauber "übersprungen". Deshalb den
# Block auskommentiert lassen, bis die Freigabe wirklich funktioniert — prüfen
# mit `python audio-service/scripts/check_nas.py`.
#NAS_SERVER=nas.example.local
#NAS_SHARE=Aufnahmen
#NAS_USER=<benutzer>
#NAS_PASSWORD=<passwort>
# Unterordner in der Freigabe, in dem die Ablage beginnt. Leer lassen, wenn die
# Ordner direkt in der Wurzel der Freigabe liegen.
#NAS_BASE_PATH=
